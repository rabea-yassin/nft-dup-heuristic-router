# --- Reference papers / documents ---
# Source papers and references stay local; our own final report is a
# deliverable and is tracked.
*.pdf
!NFT_Copymint_Final_Report.pdf
# Report figures (vector) and the poster export are deliverables too.
!report/figures/*.pdf
!poster/NFT_Copymint_Poster.pdf

# --- Large image datasets & raw NFT assets ---
# Everything under data/ is ignored except data/example/, a small,
# git-tracked subset (public Kaggle-sourced images only) that shows the
# data layout without shipping the full corpus.
data/*
!data/example/
*.png
*.jpg
*.jpeg
*.bmp
*.tiff
*.webp
*.gif
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.7z
!data/example/**/*.png
# README figures are tracked (small, hand-generated docs assets).
!docs/*.png
# Poster chart/image assets, generated by report/figures/make_figures.py.
!poster/assets/*.png

# --- Bare-metal build artifacts ---
build/
bin/
out/
*.o
*.obj
*.out
*.a
*.so
*.dll
*.exe
*.elf
*.map
*.d

# --- Logs ---
logs/
*.log

# --- Deploy key (repo-scoped SSH auth, never commit) ---
.deploy_key/

# --- Personal working notes, local-only ---
# The single live working doc: status + next actions + vocabulary.
# Findings belong in PROGRESS.md (tracked), never duplicated here.
PLAN.md
# The study & presentation guide (links into PROGRESS/GLOSSARY, no duplication).
CHEATSHEET.md
# The speaker script for the presentation deck.
SCRIPT_V3.md

# --- Editor / OS cruft ---
.vscode/
.idea/
*.swp
.DS_Store
# Office lock files, left beside any document that is open right now.
~$*

# --- Python (offline training scripts, if any) ---
__pycache__/
*.pyc
.venv/
venv/
